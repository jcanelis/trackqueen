{
  "name": "trackqueen",
  "version": "1.3.5",
  "description": "Learn more about your music.",
  "scripts": {
    "build": "npx eas-cli build --platform ios",
    "start": "npx expo start --ios -c",
    "submit": "npx eas-cli submit -p ios",
    "test": "jest",
    "eject": "expo eject",
    "format": "prettier --write *.{js,json}",
    "lint": "eslint .",
    "ios": "expo run:ios",
    "android": "expo run:android"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  },
  "dependencies": {
    "@bottom-tabs/react-navigation": "^1.1.0",
    "@expo/ui": "~58.0.21",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "@react-navigation/bottom-tabs": "^7.8.11",
    "@react-navigation/native": "^7.1.24",
    "@react-navigation/native-stack": "^7.8.5",
    "@react-navigation/stack": "^7.6.11",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "^5.100.14",
    "crypto-js": "^4.2.0",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.17",
    "expo-audio": "~58.0.9",
    "expo-auth-session": "~58.0.12",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-crypto": "~58.0.6",
    "expo-dev-client": "~58.0.14",
    "expo-device-hub": "^0.18.0",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-glass-effect": "~58.0.4",
    "expo-image": "~58.0.16",
    "expo-linking": "~58.0.13",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.9",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.17",
    "expo-web-browser": "~58.0.6",
    "prop-types": "^15.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-bottom-tabs": "^1.2.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-pager-view": "9.0.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-tab-view": "^4.2.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/compat": "^2.0.2",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "prettier": "^3.8.1",
    "react-test-renderer": "^19.2.4"
  },
  "author": "John Canelis",
  "license": "MIT",
  "private": true
}
